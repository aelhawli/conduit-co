{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conduit-api-local",
  "main": "dist/worker/index.js",
  "no_bundle": true,
  "build": { "command": "node scripts/build-worker.mjs" },
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "staging": {
      "name": "conduit-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGINS": "https://conduit-co-staging.pages.dev",
        "SUPABASE_URL": "https://kvujhszkrblaovnksafx.supabase.co",
        "GEMINI_MODEL": "gemini-3.8-flash",
        "DAILY_AUDIT_LIMIT": "25"
      },
      "ratelimits": [
        { "name": "AUDIT_RATE_LIMITER", "namespace_id": "71001", "simple": { "limit": 3, "period": 60 } },
        { "name": "FUNNEL_RATE_LIMITER", "namespace_id": "71002", "simple": { "limit": 30, "period": 60 } }
      ]
    },
    "production": {
      "name": "conduit-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://conduitco.io,https://conduit-co.pages.dev",
        "SUPABASE_URL": "https://REPLACE-PRODUCTION-PROJECT.supabase.co",
        "GEMINI_MODEL": "gemini-2.5-flash",
        "DAILY_AUDIT_LIMIT": "250"
      },
      "ratelimits": [
        { "name": "AUDIT_RATE_LIMITER", "namespace_id": "72001", "simple": { "limit": 3, "period": 60 } },
        { "name": "FUNNEL_RATE_LIMITER", "namespace_id": "72002", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  }
}
