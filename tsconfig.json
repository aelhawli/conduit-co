{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node", "vitest/globals"], "noEmit": true
  },
  "include": ["src", "tests", "worker-configuration.d.ts", "ingestion-configuration.d.ts", "vitest.config.ts", "playwright.config.ts"]
}
