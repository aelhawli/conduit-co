{
  "name": "conduit-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs staging",
    "build:production": "node scripts/build.mjs production",
    "build:test": "node scripts/build.mjs test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "worker:types": "wrangler types --env staging --include-runtime false --strict-vars false",
    "worker:cli": "wrangler",
    "worker:check": "wrangler deploy --dry-run --env staging && wrangler deploy --dry-run --env production",
    "dev:api": "wrangler dev --env staging --local"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "eslint": "10.11.0",
    "jsdom": "30.1.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
